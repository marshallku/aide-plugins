{
    "id": "word-count",
    "name": "Word count",
    "version": "1.2.0",
    "description": "Counts the words of the note you're reading: in the desktop's right panel as you go, or from the editor's plugin menu.",
    "author": "AIDE",
    "render": "web",
    "tabs": [],
    "sheets": [{ "id": "count", "title": "Word count", "icon": "textformat.size" }],
    "panels": [{ "id": "live", "title": "Word count", "icon": "textformat.size" }],
    "commands": [{ "id": "show-panel", "title": "Show the word count panel", "icon": "textformat.size" }],
    "settingsPage": { "title": "Counting options" },
    "capabilities": ["notes:read:*", "storage"],
    "locales": {
        "ko": {
            "name": "단어 수",
            "description": "읽고 있는 노트의 단어를 세요. 데스크톱 오른쪽 패널에서는 읽는 대로, 편집기의 플러그인 메뉴에서도 볼 수 있어요.",
            "settingsTitle": "세기 옵션",
            "sheets.count.title": "단어 수",
            "panels.live.title": "단어 수",
            "commands.show-panel.title": "단어 수 패널 보기"
        }
    },
    "strings": {
        "%lld words": { "en": { "one": "%lld word", "other": "%lld words" }, "ko": "%lld단어" },
        "Close": "닫기",
        "Headings (lines starting with #) aren't counted.": "제목(#으로 시작하는 줄)은 세지 않아요.",
        "Headings counted": "제목 포함",
        "Headings skipped": "제목 제외",
        "No note on screen": "화면에 노트가 없어요",
        "Saved": "저장했어요",
        "Skip headings": "제목 건너뛰기"
    }
}
